        "700": "#248a3d"
      },
      "yellow": {
        "400": "#ffd426",
        "500": "#dfbf00",
        "700": "#b79900"
      },
      "red": {
        "400": "#ff6961",
        "500": "#ff3130",
        "700": "#d70015"
      },
      "orange": {
        "400": "#ffb35b",
        "500": "#ff9500",
        "700": "#cb6f10"
      },
      "purple": {
        "400": "#da8fff",
        "500": "#af52de",
        "700": "#8944ab"
      },
      "pink": {
        "400": "#ff6482",
        "500": "#ff2d55",
        "700": "#d30f45"
      },
      "indigo": {
        "400": "#7d7aff",
        "500": "#5856d6",
        "700": "#3634a3"
      },
      "teal": {
        "400": "#70d7ff",
        "500": "#5ac8fa",
        "700": "#0071a4"
      },
      "mint": {
        "400": "#69f0ac",
        "500": "#4cdd94",
        "700": "#3fb077"
      },
      "darkGray": {
        "200": "#7c7c80",
        "300": "#6c6c70",
        "400": "#545456",
        "500": "#444446",
        "700": "#242426"
      },
      "lightGray": {
        "200": "#eee",
        "300": "#e4e4e6",
        "400": "#c4c4c6",
        "500": "#babcc0",
        "700": "#8e8e93"
      },
      "neutral": {
        "white": "#ffffff",
        "black": "#0a0a0a"
      }
    },
    "spacing": {
      "0": "0px",
      "100": "4px",
      "200": "8px",
      "300": "12px",
      "400": "16px",
      "500": "20px",
      "600": "24px",
      "700": "32px",
      "800": "40px",
      "900": "48px",
      "1000": "64px"
    },
    "radius": {
      "none": "0px",
      "100": "2px",
      "200": "4px",
      "300": "6px",
      "400": "8px",
      "500": "12px",
      "600": "16px",
      "700": "24px",
      "full": "9999px"
    },
    "font": {
      "body": "AvertaStdCY, Helvetica, sans-serif",
      "code": "SourceCodePro, Helvetica, sans-serif"
    }
  },
  "semantic": {
    "color": {
      "primary": {
        "default": "{primitive.color.blue.500}",
        "hover": "{primitive.color.blue.400}",
        "active": "{primitive.color.blue.700}"
      },
      "neutral": {
        "background": {
          "canvas": "{primitive.color.lightGray.300}",
          "surface": "{primitive.color.neutral.white}",
          "disabled": "{primitive.color.lightGray.200}"
        },
        "text": {
          "primary": "{primitive.color.darkGray.700}",
          "secondary": "{primitive.color.darkGray.400}",
          "tertiary": "{primitive.color.lightGray.700}",
          "disabled": "{primitive.color.lightGray.400}",
          "placeholder": "{primitive.color.lightGray.400}"
        },
        "border": {
          "default": "{primitive.color.lightGray.300}",
          "strong": "{primitive.color.lightGray.500}",
          "subtle": "{primitive.color.lightGray.200}"
        }
      },
      "success": {
        "default": "{primitive.color.green.500}",
        "hover": "{primitive.color.green.400}",
        "active": "{primitive.color.green.700}",
        "subtle": "#ecfdf3"
      },
      "warning": {
        "default": "{primitive.color.yellow.500}",
        "hover": "{primitive.color.yellow.400}",
        "active": "{primitive.color.yellow.700}",
        "subtle": "#fefdf0"
      },
      "danger": {
        "default": "{primitive.color.red.500}",
        "hover": "{primitive.color.red.400}",
        "active": "{primitive.color.red.700}",
        "subtle": "#fff5f5"
      },
      "info": {
        "default": "{primitive.color.blue.500}",
        "hover": "{primitive.color.blue.400}",
        "active": "{primitive.color.blue.700}",
        "subtle": "#f4f8ff"
      }
    },
    "spacing": {
      "layout": {
        "outer": "{primitive.spacing.600}",
        "gutter": "{primitive.spacing.400}"
      },
      "component": {
        "padding": {
          "compact": "{primitive.spacing.200}",
          "default": "{primitive.spacing.400}",
          "cozy": "{primitive.spacing.500}",
          "loose": "{primitive.spacing.700}"
        },
        "gap": {
          "default": "{primitive.spacing.300}",
          "tight": "{primitive.spacing.200}"
        }
      }
    },
    "radius": {
      "interactive": "{primitive.radius.300}",
      "container": "{primitive.radius.400}",
      "overlay": "{primitive.radius.500}"
    }
  },
  "component": {
    "button": {
      "primary": {
        "bg": "{semantic.color.primary.default}",
        "bgHover": "{semantic.color.primary.hover}",
        "bgActive": "{semantic.color.primary.active}",
        "text": "{primitive.color.neutral.white}"
      },
      "secondary": {
        "bg": "transparent",
        "bgHover": "{primitive.color.lightGray.200}",
        "text": "{semantic.color.neutral.text.primary}",
        "border": "{semantic.color.neutral.border.default}"
      },
      "danger": {
        "bg": "{semantic.color.danger.default}",
        "bgHover": "{semantic.color.danger.hover}",
        "text": "{primitive.color.neutral.white}"
      },
      "radius": "{semantic.radius.interactive}",
      "padding": {
        "x": "{primitive.spacing.400}",
        "y": "{primitive.spacing.200}"
      }
    },
    "card": {
      "bg": "{semantic.color.neutral.background.surface}",
      "border": "{semantic.color.neutral.border.subtle}",
      "radius": "{semantic.radius.container}",
      "padding": "{semantic.spacing.component.padding.default}"
    },
    "input": {
      "bg": "{primitive.color.neutral.white}",
      "border": "{semantic.color.neutral.border.default}",
      "borderFocus": "{semantic.color.primary.default}",
      "text": "{semantic.color.neutral.text.primary}",
      "placeholder": "{semantic.color.neutral.text.placeholder}",
      "radius": "{semantic.radius.interactive}",
      "padding": {
        "x": "{primitive.spacing.300}",
        "y": "{primitive.spacing.200}"
      }
    },
    "badge": {
      "success": {
        "bg": "{semantic.color.success.subtle}",
        "text": "{semantic.color.success.default}"
      },
      "warning": {
        "bg": "{semantic.color.warning.subtle}",
        "text": "{semantic.color.warning.default}"
      },
      "danger": {
        "bg": "{semantic.color.danger.subtle}",
        "text": "{semantic.color.danger.default}"
      },
      "radius": "{primitive.radius.full}",
      "padding": {
        "x": "{primitive.spacing.200}",
        "y": "2px"
      }
    }
  }
}
